# GitHub Manager — Local Configuration
# Copy this file to `.env` (`cp .env.example .env`) before running `cargo run`.
# You can also leave GITHUB_PAT blank here and enter your PAT directly in the web UI.

# Optional: GitHub Personal Access Token (ghp_... or github_pat_...)
# Classic PAT recommended scopes: repo, delete_repo, admin:repo_hook, read:org
# Fine-grained PAT permissions: Administration (R/W), Contents (R/W), Issues (R/W),
#                               Metadata (Read), Pull Requests (R/W), Webhooks (R/W)
GITHUB_PAT=

# Server bind host and port
HOST=127.0.0.1
PORT=8080

# Path to compiled frontend static bundle (built via `cd web && npm run build`)
STATIC_DIR=./web/dist

# GitHub REST API base URL (override only for GitHub Enterprise Server)
GITHUB_API_BASE=https://api.github.com

# --- Network / proxy troubleshooting ---------------------------------------
# If "Verify & add account" fails with "Failed to reach GitHub API:
# error sending request for url (...)", the server process could not open a
# connection to GitHub. Every request now reports the real reason (DNS, TLS,
# proxy, firewall) and you can run a step-by-step probe at
#   http://127.0.0.1:8080/api/v1/diagnostics/connectivity
# or from the UI: Token & Connection -> Connection Diagnostics.
#
# On Windows, reqwest also honours the Windows system proxy (Internet Options /
# VPN clients), which curl.exe ignores - a classic "curl works, app does not".
# Force direct connections when you are not behind the proxy:
# DISABLE_SYSTEM_PROXY=true
#
# Or point the backend at the proxy that actually reaches GitHub, e.g.
# GITHUB_PROXY=http://127.0.0.1:7890
GITHUB_PROXY=
DISABLE_SYSTEM_PROXY=false

# Rust log level
RUST_LOG=info,github_manager=debug,actix_web=info
