# GitHub Manager — Local Configuration
# Copy this file to `.env` (`cp .env.example .env`) before running `cargo run`.
# You can also leave GITHUB_PAT blank here and enter your PAT directly in the web UI.

# Optional: GitHub Personal Access Token (ghp_... or github_pat_...)
# Classic PAT recommended scopes: repo, delete_repo, admin:repo_hook, read:org
# Fine-grained PAT permissions: Administration (R/W), Contents (R/W), Issues (R/W),
#                               Metadata (Read), Pull Requests (R/W), Webhooks (R/W)
GITHUB_PAT=

# Server bind host and port
HOST=127.0.0.1
PORT=8080

# Path to compiled frontend static bundle (built via `cd web && npm run build`)
STATIC_DIR=./web/dist

# GitHub REST API base URL (override only for GitHub Enterprise Server)
GITHUB_API_BASE=https://api.github.com

# Rust log level
RUST_LOG=info,github_manager=debug,actix_web=info
